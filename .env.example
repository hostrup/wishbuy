# Kopiér til .env og udfyld. I produktion sættes værdierne i /hostrup/docker/.env
# og mappes ind via stacks/projects.yml — se AGENTS.md § Miljøvariabler.

# ── Påkrævet ────────────────────────────────────────────────────────────────
# Bemærk: hostnavnet 'postgresql' kan kun slås op inde i Docker-netværket.
# Udvikler du på hosten, skal du bruge localhost:5432.
DATABASE_URL="postgresql://wishbuy_db:PASSWORD@postgresql:5432/wishbuy_db?schema=public"

# ── Autentificering ─────────────────────────────────────────────────────────
# Headeren Authelia injicerer med brugernavnet. Default: remote-user
AUTH_HEADER="Remote-User"
# true = brug fallback-brugeren 'ronni_dev' når headeren mangler. Kun til udvikling.
DEV_MODE="false"

# ── AI (Gemini) ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=""
# Valgfri override. Uden den bruger finance + import gemini-3.6-flash.
# GEMINI_MODEL="gemini-3.6-flash"

# ── Integrationer ───────────────────────────────────────────────────────────
# Bearer-token som host-cron bruger mod /api/stocks/sync
CRON_SECRET=""
# Query-token som Home Assistant bruger mod /api/calendar/feed.ics
CALENDAR_TOKEN=""
# Kostpris-alarmer. Udelades de, springes notifikationerne over.
TELEGRAM_TOKEN=""
TELEGRAM_CHAT_ID=""
